# Modèle de configuration locale (D-010). Copier en .env et remplacer le mot de passe :
#   cp .env.example .env
# Le fichier .env n'est JAMAIS commité (règle 5) ; celui-ci ne contient aucune vraie valeur.

POSTGRES_USER=cg
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=contractguardian
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# LLM local (D-016) : nom du modèle Ollama ; qwen3:8b est la cible si le réseau le permet.
CG_LLM_MODELE=qwen3-vl:8b
CG_LLM_URL=http://127.0.0.1:11434
